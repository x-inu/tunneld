# tunneld.yaml.example — Application and daemon configuration for tunneld.
#
# Place the active copy at /etc/tunneld/tunneld.yaml.
# Generate administrator password hashes with:
#   tunneld hash-password

# Address and port to bind. By default, tunneld binds only to 127.0.0.1.
# Expose publicly only through a reverse proxy (e.g. Nginx with TLS).
listen: 127.0.0.1:8095

# Set to true only if you intentionally bind listen to 0.0.0.0 or a public IP.
allow_remote_bind: false

# SQLite database storing rotation history, system logs, audit trails, and settings.
database: /var/lib/tunneld/tunneld.db

# Path to the tunnel definitions file.
tunnels_file: /etc/tunneld/tunnels.yaml

# Path to the server-side credential store. Must have file mode 0600.
secrets_file: /etc/tunneld/secrets.yaml

# Runtime directory for generated PPP and xl2tpd configuration files.
state_dir: /run/tunneld

# Directory for generated strongSwan swanctl configuration files.
swanctl_dir: /etc/swanctl/conf.d

# Web UI administrator credentials.
admin:
  username: admin
  # Generate your own hash using: tunneld hash-password
  # Example hash below corresponds to password: "ChangeMe-2026!Tunneld"
  password_hash: "$2a$12$FR5UNfXfzcdHEzVY/g/X0u5TXQnP5rybwtTMZWYbJV/.J8A3qwwTG"

# Session settings.
session:
  cookie_name: tunneld_session
  ttl_hours: 12
  idle_minutes: 120
  # secure_override: "" (auto: true if HTTPS or trusted proxy header), "true", or "false"
  secure_override: ""

# Health check settings.
health:
  interval_seconds: 15
  timeout_seconds: 8
  ping_timeout_ms: 2500
  fail_threshold: 3
  cooldown_seconds: 120
  log_retention_days: 30

# Route rotation settings.
rotation:
  # Supported modes: manual, timer, failover
  default_mode: manual
  default_interval_minutes: 10
  min_interval_minutes: 1
  max_interval_minutes: 60
  verify_timeout_seconds: 20
  min_healthy: 2

# Linux routing and interface parameters.
network:
  # Leave uplink_interface and uplink_gateway empty to auto-detect from the current default route.
  uplink_interface: ""
  uplink_gateway: ""
  # Host route ensures packets to tunnel servers always go through the original uplink gateway.
  host_route: true
  route_table_base: 200
  rule_priority_base: 10000

# Public IP verification endpoints queried during health checks and route switches.
checker_urls:
  - https://api.ipify.org
  - https://ifconfig.me/ip
  - https://icanhazip.com

# System binary paths.
commands:
  ip: /usr/sbin/ip
  ping: /usr/bin/ping
  curl: /usr/bin/curl
  pppd: /usr/sbin/pppd
  xl2tpd: /usr/sbin/xl2tpd
  sstpc: /usr/sbin/sstpc
  pptp: /usr/sbin/pptp
  swanctl: /usr/sbin/swanctl

# PPP up/down hook directories for iproute2 table management.
ip_up_dir: /etc/ppp/ip-up.d
ip_down_dir: /etc/ppp/ip-down.d

# Trust X-Forwarded-For and X-Forwarded-Proto from 127.0.0.1 (Nginx/reverse proxy).
trust_proxy: true

# Demo simulation mode. When true, tunnel interfaces and routes are simulated safely.
demo: false

# Log level: debug, info, warn, or error.
log_level: info
