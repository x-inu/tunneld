# secrets.yaml.example — Server-side credential store for tunneld.
#
# Place the active copy at /etc/tunneld/secrets.yaml.
#
# PERMISSIONS:
#   chmod 0600 /etc/tunneld/secrets.yaml
#   chown root:root /etc/tunneld/secrets.yaml
#
# tunneld enforces mode 0600 and will automatically chmod or reject startup
# if permissions are insecure.
#
# Values in this file are NEVER returned by the web API, never written to
# SQLite logs or audit trails, and never shown in the dashboard UI.
# Only boolean presence flags (has_password, has_psk) are reported to the frontend.

secrets:
  # Credentials matching tunnels.yaml.example references
  de-fra-01-password: "SuperSecretPassword1!"
  de-fra-01-psk: "PreSharedKeyForIPsecTunnelDe1"

  nl-ams-01-password: "SuperSecretPassword2!"

  ch-zrh-01-password: "SuperSecretPassword3!"

  jp-tyo-01-password: "SuperSecretPassword4!"

  us-nyc-01-password: "SuperSecretPassword5!"

  uk-lon-01-password: "SuperSecretPassword6!"

  sg-sin-01-password: "SuperSecretPassword7!"
  sg-sin-01-psk: "PreSharedKeyForIPsecTunnelSg1"
